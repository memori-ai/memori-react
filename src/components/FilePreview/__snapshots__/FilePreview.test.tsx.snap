// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`renders FilePreview unchanged 1`] = `<div />`;

exports[`renders FilePreview with one file 1`] = `
<div>
  <div
    class="memori--preview-container"
  >
    <div
      class="memori--document-count"
    >
      1
      /
      10
    </div>
    <div
      class="memori--preview-list"
    >
      <div
        class="memori--preview-item memori--preview-item--document"
      >
        <button
          aria-label="test.pdf"
          class="memori--preview-item-trigger"
          type="button"
        >
          <div
            class="memori-media-item--document"
          >
            <div
              class="memori-media-item--document-header"
            >
              <div
                class="memori-media-item--document-title"
              >
                test.pdf
              </div>
            </div>
            <span
              class="memori-media-item--document-badge"
            >
              PDF
            </span>
          </div>
        </button>
        <button
          aria-label="upload.removeFile"
          class="memori-button memori-button--ghost memori-button--sm memori-button--circle memori-button--icon-only memori--remove-button"
          tabindex="0"
          type="button"
        >
          <span
            class="memori-button__icon"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-x"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18 6 6 18"
              />
              <path
                d="m6 6 12 12"
              />
            </svg>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
`;

